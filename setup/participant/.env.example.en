# OpenSearch connection settings (replace with information provided by the instructor)
OPENSEARCH_HOST=<instructor-ip-address>  # e.g. 192.168.1.100
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=<password distributed by instructor>
# The hands-on cluster serves a self-signed certificate
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=false

# IBM watsonx.ai settings (used to generate the embeddings)
IBM_API_KEY=<your IBM Cloud API key>
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=<your watsonx.ai project ID>
# The vector dimension is detected automatically from the model
EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual

# Index settings
# IMPORTANT: OpenSearch is shared by all participants.
# Set an index name that is unique to you (e.g. products_taro)
INDEX_NAME=products_<your_name>  # e.g. products_taro

# Participant language (en or ja)
PARTICIPANT_LANGUAGE=en

# How to use:
# 1. Copy this file to .env
# 2. Update connection settings with the values provided by the instructor
#    - On-site (same network): change OPENSEARCH_HOST to the IP address (e.g. 192.168.1.100)
#    - Remote (ngrok): change OPENSEARCH_HOST to the hostname AND OPENSEARCH_PORT to the assigned port
#      e.g. OPENSEARCH_HOST=0.tcp.jp.ngrok.io / OPENSEARCH_PORT=24051
# 3. Change OPENSEARCH_PASSWORD to the password distributed by the instructor
# 4. Set IBM_API_KEY and WATSONX_PROJECT_ID to your own watsonx.ai credentials
# 5. Change INDEX_NAME to a name unique to you (e.g. products_taro)
# 6. Reload IBM Bob (Cmd+Shift+P -> "Reload Window")

# Embedding models available on watsonx.ai (us-south):
# - ibm/granite-embedding-278m-multilingual (768 dim, 12 languages, recommended)
# - intfloat/multilingual-e5-large (multilingual)
# - ibm/slate-125m-english-rtrvr-v2 (English only)
# - ibm/slate-30m-english-rtrvr-v2 (English only, faster)
# - sentence-transformers/all-minilm-l6-v2 (English only, faster)
