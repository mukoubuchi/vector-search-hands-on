# OpenSearch 接続設定（講師から共有された情報に置き換えてください）
OPENSEARCH_HOST=<講師のIPアドレス>  # 例: 192.168.1.100
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=<講師から配布されたパスワード>
# ハンズオン環境は自己署名証明書を使います
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=false

# IBM watsonx.ai 設定（埋め込みベクトルの生成に使います）
IBM_API_KEY=<あなたの IBM Cloud API キー>
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=<あなたの watsonx.ai プロジェクト ID>
# ベクトルの次元数はモデルから自動で判定されます
EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual

# インデックス設定
# 重要: OpenSearch は参加者全員で共有します。
# 自分だけのインデックス名を設定してください（例: products_taro）
INDEX_NAME=products_<あなたの名前>  # 例: products_taro

# 参加者の言語（en または ja）
PARTICIPANT_LANGUAGE=ja

# 使い方:
# 1. このファイルを .env にコピーします
# 2. 講師から共有された値で接続設定を更新します
#    - 会場（同一ネットワーク）: OPENSEARCH_HOST を IP アドレスに変更（例: 192.168.1.100）
#    - リモート（ngrok）: OPENSEARCH_HOST をホスト名に、OPENSEARCH_PORT を指定されたポートに変更
#      例: OPENSEARCH_HOST=0.tcp.jp.ngrok.io / OPENSEARCH_PORT=24051
# 3. OPENSEARCH_PASSWORD を講師から配布されたパスワードに変更します
# 4. IBM_API_KEY と WATSONX_PROJECT_ID に自分の watsonx.ai の資格情報を設定します
# 5. INDEX_NAME を自分だけの名前に変更します（例: products_taro）
# 6. IBM Bob を再読み込みします（Cmd+Shift+P →「Reload Window」）

# watsonx.ai（us-south）で使える埋め込みモデル:
# - ibm/granite-embedding-278m-multilingual（768 次元、12 言語対応、推奨）
# - intfloat/multilingual-e5-large（多言語）
# - ibm/slate-125m-english-rtrvr-v2（英語のみ）
# - ibm/slate-30m-english-rtrvr-v2（英語のみ、高速）
