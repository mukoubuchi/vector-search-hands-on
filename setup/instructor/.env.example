# OpenSearch settings (instructor - local container environment)
# Generated automatically by start-all.sh on first start (leave empty here).
# The security plugin refuses to start without a compliant password, and the
# same value is shared with participants.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# Connection settings for running the participant scripts from this directory
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
# Kept in sync with OPENSEARCH_INITIAL_ADMIN_PASSWORD by start-all.sh
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=false

# IBM watsonx.ai settings (used to generate the embeddings)
IBM_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual

# Index settings (use your own unique name when testing participant scripts)
INDEX_NAME=products_instructor

# How to use:
# 1. You normally do NOT need to copy this file: ./start-all.sh creates and
#    updates setup/instructor/.env with the generated password automatically.
# 2. Copy this file to .env only if you want to pre-seed values by hand.
# 3. docker compose reads OPENSEARCH_INITIAL_ADMIN_PASSWORD from .env; the
#    participant-style scripts read the OPENSEARCH_* and watsonx.ai values
#    when run with this directory's .env.
